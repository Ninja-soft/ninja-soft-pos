# =============================================================================
# NinjaSoft POS — Variables de entorno
# =============================================================================
# Copiar a `.env.local` y completar con los valores reales para tu entorno.
# Este archivo NO contiene secretos reales. Nunca commitear `.env.local`.
# =============================================================================

# -----------------------------------------------------------------------------
# Entorno
# -----------------------------------------------------------------------------
# Valores: local | preview | staging | production
APP_ENV=local

# URL pública de la app (sin slash final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Estas dos son PÚBLICAS y van al cliente.
# `supabase start` te las imprime al levantar el stack local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...REEMPLAZAR

# SERVICE ROLE — PRIVADA, JAMÁS EN EL FRONTEND.
# Solo para uso local (Edge Functions corriendo localmente, scripts de seed,
# acceso del agente supabase-architect a la DB local).
# En staging/producción se gestiona vía Vercel/Supabase, no en este archivo.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...REEMPLAZAR

# -----------------------------------------------------------------------------
# Observabilidad
# -----------------------------------------------------------------------------
# Sentry (errores). Vacío = desactivado.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# Resend (envío de emails transaccionales).
RESEND_API_KEY=

# Email "from" por defecto para emails transaccionales.
EMAIL_FROM="NinjaSoft <no-reply@ninjasoft.app>"

# -----------------------------------------------------------------------------
# AFIP (facturación electrónica — Fase 3)
# -----------------------------------------------------------------------------
# Valores: homologacion | produccion
AFIP_ENVIRONMENT=homologacion

# Estas dos son ejemplos. La integración real se hace por Edge Function
# y los certificados se almacenan encriptados en la DB, no en .env.
AFIP_CERT_PATH=
AFIP_KEY_PATH=

# -----------------------------------------------------------------------------
# Pagos (Fase 2+)
# -----------------------------------------------------------------------------
# Ejemplo MercadoPago. Ajustar al proveedor que se elija.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Feature flags overrides (solo dev)
# -----------------------------------------------------------------------------
# Útil para forzar flags en local sin tocar la DB.
# Formato: comma-separated. Ej: "afip_integration=true,multi_currency=false"
NEXT_PUBLIC_FEATURE_FLAGS_OVERRIDE=
